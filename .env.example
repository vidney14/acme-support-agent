# Copy to .env (repo root) or backend/.env. The backend reads both.

# --- Required for real use (free key: https://aistudio.google.com -> Get API key) ---
GEMINI_API_KEY=

# "gemini" (default) or "fake" = offline mode: rule-based agent + simulated voice, no key needed
LLM_PROVIDER=gemini

# --- Models (override if Google renames/retires one) ---
CHAT_MODEL=gemini-3.8-flash
CHAT_THINKING_LEVEL=low
FALLBACK_MODEL=gemini-3.5-flash-lite
FALLBACK_THINKING_LEVEL=minimal
VERIFIER_MODEL=gemini-3.5-flash-lite
LIVE_MODEL=gemini-3.8-live
LIVE_VOICE=Kore
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768

# --- Guardrails (calibrate with: python -m scripts.calibrate_thresholds) ---
CONFIDENCE_HIGH=0.72
CONFIDENCE_LOW=0.55
RETRIEVAL_TOP_K=4

# --- Vector store: empty = embedded Qdrant in-process. Set for Qdrant Cloud. ---
QDRANT_URL=
QDRANT_API_KEY=

# --- API / production ---
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MINUTE=12
RATE_LIMIT_BURST=4
MAX_CONCURRENT_VOICE_SESSIONS=3
ENABLE_FAULT_INJECTION=true
